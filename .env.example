# Copy to .env and fill in. Never commit the real .env file.

# Postgres connection string. For local dev: `npx prisma dev` prints one you
# can paste here, or point at your own local/hosted Postgres instance.
#
# In production (e.g. Supabase): DATABASE_URL should be the POOLED/Supavisor
# connection string (port 6543) — required for a serverless runtime like
# Vercel, which can open far more concurrent connections than Postgres allows
# directly. Set DIRECT_URL (below) to the DIRECT, non-pooled connection
# (port 5432) so `prisma migrate deploy` runs through that instead — Prisma
# Migrate doesn't run reliably through a transaction-mode pooler.
DATABASE_URL="postgresql://user:password@localhost:5432/evenkletsen?schema=public"

# Production only — leave unset locally. See DATABASE_URL comment above.
# DIRECT_URL="postgresql://user:password@direct-host:5432/postgres"

# Auth.js — generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=""

# Production only — leave unset locally (trustHost + the request's own host
# header is fine for local dev, where there's only ever one possible host).
# Forces Auth.js to always build magic-link/callback URLs against this exact
# domain, regardless of which hostname actually received the request (e.g.
# an old *.vercel.app URL) — required once more than one hostname can reach
# the deployment.
# AUTH_URL="https://leefenlach.com"

# Transactional email (magic-link sign-in) — https://resend.com. The `from`
# address's domain must be added and verified at resend.com/domains — Resend
# rejects sends to anyone but your own account email until it is.
RESEND_API_KEY=""
EMAIL_FROM="Leef en Lach <evenkletsen@leefenlach.com>"

# Realtime chat — https://dashboard.pusher.com (Channels app)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# Base URL of the app, used for absolute links (payment return URLs, emails).
# In production this must be the real public domain, e.g. "https://leefenlach.com".
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments — mock provider needs nothing.
PAYMENT_PROVIDER="mock"

# Mollie — set PAYMENT_PROVIDER=mollie to enable. Get an API key at
# https://my.mollie.com (test_... key works immediately for sandbox
# payments; switch to a live_... key to go live — no separate sandbox flag,
# Mollie infers test/live mode from the key itself).
# MOLLIE_API_KEY=""

# Tikkie (ABN AMRO) — set PAYMENT_PROVIDER=tikkie to enable. NOTE: requires a
# business bank account AT ABN AMRO SPECIFICALLY (~€7.50/month, Tikkie voor
# Bedrijven) — not usable with an ING/Rabobank/other-bank account. Built but
# unused for now; kept in case that changes. API access issued via
# https://developer.abnamro.com — TIKKIE_APP_TOKEN comes from registering an
# app there (or POST .../tikkie/sandboxapps for a sandbox one). After setting
# these, run `npm run tikkie:register-webhook` once per environment to point
# Tikkie's payment notifications at this app.
# TIKKIE_API_KEY=""
# TIKKIE_APP_TOKEN=""
# TIKKIE_SANDBOX="true"

# Protects the two /api/cron/* endpoints from being triggered by anyone but
# Vercel Cron. Required in production; optional in dev.
CRON_SECRET=""
